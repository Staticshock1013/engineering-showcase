# Copy to .env and fill in locally. Never commit real values.
# Variable names only — no secrets in this file.

# Robinhood (equity historical prices — research / export only)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional: path to a local CSV/Parquet export if API auth is unavailable
ROBINHOOD_DATA_DIR=

# Massive (futures aggregates — NQ front-month, 1-min and daily)
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# Optional: override default symbols / paths
MASSIVE_NQ_ROOT=NQ
MASSIVE_DATA_DIR=

# Shared research settings
QUANT_LAB_CACHE_DIR=data/cache
QUANT_LAB_OUTPUT_DIR=outputs
QUANT_LAB_HOLDOUT_START=2024-01-01
