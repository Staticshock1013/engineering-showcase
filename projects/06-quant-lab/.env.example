# Copy to .env and fill in locally. Never commit real values.
# Variable names only — no secrets in this file.

# Robinhood equity bars: local CSV/Parquet exports only (no unofficial API client).
# Point this at a directory you populate yourself (e.g. MCP export). Do not commit the files.
ROBINHOOD_DATA_DIR=

# Massive (Polygon rebrand) — futures aggregates. Store the key as a Cursor/GitHub secret;
# never paste it into chat or commit it. Live downloads stay disabled until the key is set.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_NQ_ROOT=NQ
MASSIVE_DATA_DIR=

# Shared research settings
QUANT_LAB_CACHE_DIR=data/cache
QUANT_LAB_OUTPUT_DIR=outputs
QUANT_LAB_HOLDOUT_START=2024-01-01
